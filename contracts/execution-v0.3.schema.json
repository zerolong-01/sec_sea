{
  "$defs": {
    "CallPurpose": {
      "enum": [
        "generation",
        "detection"
      ],
      "title": "CallPurpose",
      "type": "string"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "DefenseDecision": {
      "enum": [
        "allow",
        "block",
        "redact",
        "quarantine"
      ],
      "title": "DefenseDecision",
      "type": "string"
    },
    "DefenseEvent": {
      "additionalProperties": false,
      "properties": {
        "defense_id": {
          "enum": [
            "D1",
            "D2"
          ],
          "title": "Defense Id",
          "type": "string"
        },
        "defense_version": {
          "minLength": 1,
          "title": "Defense Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "input",
            "retrieval",
            "prompt_assembly",
            "output"
          ],
          "title": "Stage",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/DefenseDecision"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "score_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Kind"
        },
        "threshold_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefenseDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consistency_issue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consistency Issue"
        },
        "review_needed": {
          "default": false,
          "title": "Review Needed",
          "type": "boolean"
        }
      },
      "required": [
        "defense_id",
        "defense_version",
        "stage",
        "decision",
        "reason_code"
      ],
      "title": "DefenseEvent",
      "type": "object"
    },
    "DefenseMode": {
      "enum": [
        "none",
        "D1",
        "D2",
        "D1+D2"
      ],
      "title": "DefenseMode",
      "type": "string"
    },
    "DefensePosition": {
      "enum": [
        "input",
        "retrieval",
        "input_retrieval"
      ],
      "title": "DefensePosition",
      "type": "string"
    },
    "DetectorAnalysisStatus": {
      "enum": [
        "correct",
        "valid_json_misclassification",
        "detector_error",
        "review_needed",
        "not_evaluated"
      ],
      "title": "DetectorAnalysisStatus",
      "type": "string"
    },
    "DetectorEvaluation": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "input",
            "retrieval"
          ],
          "title": "Stage",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "gold_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectorGoldLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gold_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold Version"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "evaluated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "analysis_status": {
          "$ref": "#/$defs/DetectorAnalysisStatus",
          "default": "not_evaluated"
        }
      },
      "required": [
        "stage"
      ],
      "title": "DetectorEvaluation",
      "type": "object"
    },
    "DetectorGoldLabel": {
      "enum": [
        "malicious",
        "benign",
        "hard_negative",
        "review_needed"
      ],
      "title": "DetectorGoldLabel",
      "type": "string"
    },
    "DetectorGoldUpdate": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "input",
            "retrieval"
          ],
          "title": "Stage",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "gold_label": {
          "$ref": "#/$defs/DetectorGoldLabel"
        },
        "gold_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Gold Version",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "gold_label",
        "gold_version",
        "reviewer",
        "reason"
      ],
      "title": "DetectorGoldUpdate",
      "type": "object"
    },
    "DetectorRate": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "DetectorRate",
      "type": "object"
    },
    "DetectorReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3",
          "default": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "report_version": {
          "default": "detector-target-rates-v0.1",
          "title": "Report Version",
          "type": "string"
        },
        "denominator_rule": {
          "title": "Denominator Rule",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/DetectorReportGroup"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "denominator_rule",
        "groups"
      ],
      "title": "DetectorReport",
      "type": "object"
    },
    "DetectorReportGroup": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Run Ids",
          "type": "array"
        },
        "inspected_target_count": {
          "title": "Inspected Target Count",
          "type": "integer"
        },
        "eligible_target_count": {
          "title": "Eligible Target Count",
          "type": "integer"
        },
        "detector_error_count": {
          "title": "Detector Error Count",
          "type": "integer"
        },
        "review_needed_count": {
          "title": "Review Needed Count",
          "type": "integer"
        },
        "not_evaluated_count": {
          "title": "Not Evaluated Count",
          "type": "integer"
        },
        "fnr": {
          "$ref": "#/$defs/DetectorRate"
        },
        "fpr": {
          "$ref": "#/$defs/DetectorRate"
        },
        "benign_fpr": {
          "$ref": "#/$defs/DetectorRate"
        },
        "hard_negative_fpr": {
          "$ref": "#/$defs/DetectorRate"
        }
      },
      "required": [
        "conditions",
        "run_ids",
        "inspected_target_count",
        "eligible_target_count",
        "detector_error_count",
        "review_needed_count",
        "not_evaluated_count",
        "fnr",
        "fpr",
        "benign_fpr",
        "hard_negative_fpr"
      ],
      "title": "DetectorReportGroup",
      "type": "object"
    },
    "DetectorReportRequest": {
      "additionalProperties": false,
      "properties": {
        "run_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Run Ids",
          "type": "array"
        }
      },
      "required": [
        "run_ids"
      ],
      "title": "DetectorReportRequest",
      "type": "object"
    },
    "ErrorRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "EvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "attack_success": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "normal_task_success": {
          "enum": [
            "success",
            "failure",
            "not_evaluated",
            "review_needed"
          ],
          "title": "Normal Task Success",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "evaluated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        }
      },
      "required": [
        "attack_success",
        "normal_task_success",
        "evaluator_version",
        "reason"
      ],
      "title": "EvaluationResult",
      "type": "object"
    },
    "EvaluationStatus": {
      "enum": [
        "success",
        "failure",
        "not_applicable",
        "not_evaluated",
        "review_needed"
      ],
      "title": "EvaluationStatus",
      "type": "string"
    },
    "EvaluationUpdate": {
      "additionalProperties": false,
      "properties": {
        "attack_success": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "normal_task_success": {
          "enum": [
            "success",
            "failure",
            "not_evaluated",
            "review_needed"
          ],
          "title": "Normal Task Success",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "evaluated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated At"
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        }
      },
      "required": [
        "attack_success",
        "normal_task_success",
        "evaluator_version",
        "reason",
        "reviewer"
      ],
      "title": "EvaluationUpdate",
      "type": "object"
    },
    "ExecutionKind": {
      "enum": [
        "full_pipeline",
        "detector_only"
      ],
      "title": "ExecutionKind",
      "type": "string"
    },
    "ExecutionScope": {
      "enum": [
        "demo",
        "fixture",
        "real"
      ],
      "title": "ExecutionScope",
      "type": "string"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "system_prompt_version": {
          "minLength": 1,
          "title": "System Prompt Version",
          "type": "string"
        },
        "generation_parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Generation Parameters",
          "type": "object"
        },
        "retrieval_config_version": {
          "minLength": 1,
          "title": "Retrieval Config Version",
          "type": "string"
        },
        "defense_config_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Defense Config Versions",
          "type": "object"
        },
        "provider": {
          "default": "demo",
          "title": "Provider",
          "type": "string"
        },
        "execution_scope": {
          "$ref": "#/$defs/ExecutionScope",
          "default": "demo"
        },
        "base_system_prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base System Prompt Version"
        },
        "defense_position": {
          "$ref": "#/$defs/DefensePosition",
          "default": "input_retrieval"
        },
        "d2_configuration": {
          "additionalProperties": true,
          "title": "D2 Configuration",
          "type": "object"
        },
        "evaluator_version": {
          "default": "manual-v0.1",
          "title": "Evaluator Version",
          "type": "string"
        },
        "pricing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Version"
        },
        "max_model_calls": {
          "default": 8,
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "pricing_snapshot": {
          "additionalProperties": true,
          "title": "Pricing Snapshot",
          "type": "object"
        },
        "execution_kind": {
          "$ref": "#/$defs/ExecutionKind",
          "default": "full_pipeline"
        }
      },
      "required": [
        "model_id",
        "system_prompt_version",
        "generation_parameters",
        "retrieval_config_version",
        "defense_config_versions"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageMetric"
          },
          "title": "Stages",
          "type": "array"
        },
        "model_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Model Call Count",
          "type": "integer"
        },
        "generation_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Generation Call Count",
          "type": "integer"
        },
        "detection_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Detection Call Count",
          "type": "integer"
        },
        "unpriced_call_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unpriced Call Count",
          "type": "integer"
        },
        "known_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Known Cost Usd",
          "type": "number"
        },
        "cost_complete": {
          "default": false,
          "title": "Cost Complete",
          "type": "boolean"
        },
        "usage_source": {
          "$ref": "#/$defs/UsageSource",
          "default": "unknown"
        },
        "generation_skipped_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Skipped Reason"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "$ref": "#/$defs/CallPurpose"
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "title": "Messages",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "usage_source": {
          "$ref": "#/$defs/UsageSource",
          "default": "unknown"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "cost_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Reason"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "response_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
