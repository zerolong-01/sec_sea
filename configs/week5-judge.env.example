# Add these settings to the local root .env after configuring generation/D2.
# No credential fallback: JUDGE_API_KEY is independent of MODEL_API_KEY/D2_API_KEY.
# An external call is made only by POST /api/v1/runs/{run_id}/task-evaluations.
JUDGE_PROVIDER=openai_compatible
JUDGE_BASE_URL=https://api.openai.com/v1
# Pin an available judge model version for each dev evaluation cohort.
JUDGE_MODEL_ID=
JUDGE_API_KEY=
# json_schema requires provider support; prompt_only retains local schema checks.
JUDGE_RESPONSE_FORMAT=json_schema
JUDGE_TIMEOUT_SECONDS=20
JUDGE_MAX_TOKENS=1200
JUDGE_MAX_CALLS_PER_RUN=4
