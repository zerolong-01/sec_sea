# Copy to the repository root as .env; existing process variables take priority.
# Set MODEL_API_KEY locally. The key and .env must not be committed.
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-4.1-mini-2025-04-14
MODEL_API_KEY=
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=512
MODEL_TIMEOUT_SECONDS=30
MAX_MODEL_CALLS=8
D2_BASE_URL=https://api.openai.com/v1
D2_MODEL_ID=gpt-4.1-mini-2025-04-14
D2_API_KEY=
D2_THRESHOLD=0.5
D2_ERROR_POLICY=fail_closed
D2_DOCUMENT_ACTION=quarantine
D2_VERSION=llm-injection-v0.1
D2_POLICY_VERSION=d2-policy-v0.2
D2_CONSISTENCY_POLICY=review_on_contradiction
# json_schema는 제공자가 지원하는 경우에만 사용한다. 판정 정확성을 보장하지 않는다.
D2_RESPONSE_FORMAT=prompt_only
# Optional draft evaluation and unverified pricing; uncomment to use.
# Relative file paths are resolved from the repository root.
# PRICING_FILE=configs/pricing-placeholder.json
# EVALUATION_RULES_FILE=configs/evaluation-starter.json
